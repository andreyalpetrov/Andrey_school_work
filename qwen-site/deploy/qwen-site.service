[Unit]
Description=Qwen site (Flask + gunicorn)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
# Окружение .venv создаётся командой "uv sync" (шаг 3 в README.md)
User=www-data
Group=www-data
WorkingDirectory=/opt/qwen-site
# Один процесс (workers 1) обязателен: блокировка "одна генерация за раз"
# и счётчик неудачных входов живут в памяти процесса.
# Потоки нужны, чтобы во время ответа модели открывались остальные страницы.
ExecStart=/opt/qwen-site/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 0 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
